# ---------------------------------------------------------------------
# NADA DE DADO REAL NESTE REPOSITÓRIO.
#
# A automação baixa documentos financeiros reais (Despesa Certificada,
# Nota de Lançamento, Preparação de Pagamento, Ordem Bancária) e grava
# uma sessão com números de processo, valores e caminhos de arquivo que
# contêm o login do Windows de quem rodou. Nada disso pode ir pro Git.
# ---------------------------------------------------------------------

# Sessão: processo, OB, valores e caminhos absolutos da máquina
sessao_atual.json

# Pastas de processo criadas pela automação (0000.000000.2026-00/ etc.),
# com os JPGs dos documentos baixados
[0-9][0-9][0-9][0-9].[0-9][0-9][0-9][0-9][0-9][0-9].*/

# PDFs temporários, caso a automação pare no meio de um download
temp_*.pdf

# Backups locais
_backup*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Editores e sistema
.vscode/
.idea/
Thumbs.db
desktop.ini

# O Python que o lancador baixa quando a maquina nao tem um
python-embutido/

# Marca do que o lancador ja instalou
.lba-instalado

# Sobras de compilacao do lancador
lancador/*.o

# Saída do PyInstaller e do Inno Setup (instalador/construir.py)
build/
dist/
instalador/versao_exe.txt

# Relatórios do modo lote: números de processo e de OB
lotes/

# Progresso da etapa do SEI (por processo/OB): processos, OBs e
# endereços de documentos do SEI
progresso_sei.json
progresso_sei_concluido.json

# Dados que o programa grava na pasta de dados (normalmente em
# Documentos\Automacao SIGEF-SEI, mas LBA_PASTA_DADOS pode apontar pra
# cá): registros da janela, métricas, relatórios gerenciais e
# preferências locais
registros/
metricas/
relatorios/
config.json

# Dados que o BB grava ao lado do próprio arquivo quando roda sozinho
# (python automacoes/bb/automacoes_bb.py):
# configuração, PDFs de saldo/demonstrativo, perfil do Chrome do BB
config_sistema_bb.json
demonstrativos_pdf/
saldos_carga/
perfil_chrome_bb/
debug_html/

# Cópias de segurança feitas antes de uma alteração
# (ex.: etapa_sei2.py.bak_antes_divisao)
*.bak_*
